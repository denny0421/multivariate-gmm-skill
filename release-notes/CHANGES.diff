+# Stage 5 descriptions are reused, never re-derived: parse, verify by exact round trip, else keep the original.
+rp_zh_desc_line <- function(s) {
+  parse_items <- function(rest) {
+    m <- gregexpr('(.+?) \\(([+-][0-9]+\\.[0-9]{2}) SD; mean ([^)]*)\\)(, |$)', rest, perl = TRUE)
+    hits <- regmatches(rest, m)[[1]]; if (!length(hits)) return(NULL)
+    parts <- regmatches(hits, regexec('^(.+?) \\(([+-][0-9]+\\.[0-9]{2}) SD; mean ([^)]*)\\)(, )?$', hits, perl = TRUE))
+    if (any(lengths(parts) < 4)) return(NULL)
+    d <- data.frame(var = vapply(parts, `[`, '', 2), d = vapply(parts, `[`, '', 3), mean = vapply(parts, `[`, '', 4), stringsAsFactors = FALSE)
+    if (!identical(paste(sprintf('%s (%s SD; mean %s)', d$var, d$d, d$mean), collapse = ', '), rest)) return(NULL)
+    d
+  }
+  item_zh <- function(d) paste(sprintf('%s（%s SD；平均 %s）', d$var, d$d, trimws(d$mean)), collapse = '、')
+  for (k in c('higher', 'lower')) {
+    pre <- sprintf('%s than the overall mean: ', k)
+    if (startsWith(s, pre)) { d <- parse_items(substring(s, nchar(pre) + 1L)); if (is.null(d)) return(NULL)
+      return(sprintf('%s：%s', if (k == 'higher') '高於整體平均' else '低於整體平均', item_zh(d))) }
+  }
+  mm <- regmatches(s, regexec('^near the overall mean \\(\\|d\\| < ([^ ]+) SD\\): (.+)$', s, perl = TRUE))[[1]]
+  if (length(mm) == 3L) { vars <- strsplit(mm[3], ', ', fixed = TRUE)[[1]]
+    if (!identical(paste('near the overall mean (|d| < ', mm[2], ' SD): ', paste(vars, collapse = ', '), sep = ''), s)) return(NULL)
+    return(sprintf('接近整體平均（|d| < %s SD）：%s', mm[2], paste(vars, collapse = '、'))) }
+  NULL
+}
+rp_zh_desc <- function(lines) {
+  z <- lapply(lines, rp_zh_desc_line)
+  if (any(vapply(z, is.null, NA))) return(list(ok = FALSE, text = NULL))
+  list(ok = TRUE, text = unlist(z))
+}
