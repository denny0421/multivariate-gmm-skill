+# ARI / NMI cases from the counts actually used (no thresholds): A normal, B one side has one class,
+# C both sides one class (special branch), S both sides all singletons (special branch), D no usable rows.
+rp_zh_agreement_case <- function(n_used, comp_sizes, label_sizes) {
+  comp_sizes <- comp_sizes[comp_sizes > 0]; label_sizes <- label_sizes[label_sizes > 0]
+  if (is.null(n_used) || is.na(n_used) || n_used == 0) return('D')
+  g <- length(comp_sizes); k <- length(label_sizes)
+  if (g == 1L && k == 1L) return('C')
+  if (n_used > 1 && all(comp_sizes == 1) && all(label_sizes == 1)) return('S')
+  if (g == 1L || k == 1L) return('B')
+  'A'
+}
